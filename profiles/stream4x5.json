  "profiles": {
    "windows": {
      "*": {
        "controls": [
          "input_1_gain",
          "input_2_gain",
          "input_1_mute",
          "input_2_mute",
          "input_1_phantom",
          "input_2_phantom",
          "input_1_high_pass",
          "input_2_high_pass",
